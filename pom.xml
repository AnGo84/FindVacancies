        <module>findvacancies-web-flux</module>
        <module>common</module>
        <module>rest</module>
        <module>webflux</module>
    </modules>

    <properties>
        <!-- App version -->
        <app.version>3.0</app.version>

        <!-- Generic properties -->
        <default.encoding>UTF-8</default.encoding>
        <java.version>21</java.version>
        <maven.version>3.9.6</maven.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>${default.encoding}</project.build.sourceEncoding>
        <project.reporting.outputEncoding>${default.encoding}</project.reporting.outputEncoding>

        <spring-boot.version>3.5.3</spring-boot.version>

        <!-- Test -->
         <!-- todo: to remove. Junit and mockito are parts of Spring Boot test -->
        <junit-platform.version>1.13.3</junit-platform.version>
        <junit-jupiter.version>5.13.3</junit-jupiter.version>
        <mockito-core.version>5.18.0</mockito-core.version>
        <!-- /Test -->

        <lombok.version>1.18.38</lombok.version>

        <hibernate-validator.version>9.0.1.Final</hibernate-validator.version>

        <!-- JSON parsing -->
        <jsoup.version>1.21.1</jsoup.version>
        <json.version>20250517</json.version>

        <!-- XML -->
        <jakarta.xml.bind-api.version>4.0.2</jakarta.xml.bind-api.version>
        <jaxb-impl.version>4.0.5</jaxb-impl.version>

        <!-- Excel -->
        <poi-ooxml.version>5.4.1</poi-ooxml.version>

        <!-- Swagger -->
        <springdoc-openapi.version>2.8.9</springdoc-openapi.version>

        <!-- Plugins -->

        <!-- check this-->
        <maven-site-plugin.version>4.0.0-M13</maven-site-plugin.version>

        <maven.compiler.plugin.version>3.14.0</maven.compiler.plugin.version>
        <maven.dependency.plugin.version>3.8.1</maven.dependency.plugin.version>

        <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
        <!-- Define the version of the byte-buddy-agent used by Mockito -->
        <byte-buddy-agent.version>1.17.6</byte-buddy-agent.version>

        <maven-failsafe-plugin.version>3.5.3</maven-failsafe-plugin.version>

        <maven.versions.plugin.version>2.18.0</maven.versions.plugin.version>
    </properties>

