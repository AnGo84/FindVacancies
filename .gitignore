# ----------------------------------------
# 1. BUILD ARTIFACTS (MAVEN & GENERAL)
# ----------------------------------------
# Standard Maven output directory
/target/
# IntelliJ's default output directory
/out/
# Project build logs
*.log
# Package and coverage reports
/jacoco
/surefire-reports
/failsafe-reports

# ----------------------------------------
# 2. VAADIN FLOW SPECIFIC
# ----------------------------------------
# Node modules folder used by Vaadin/Vite for frontend dependencies.
/node_modules/
# Package manager configuration and cache (npm, pnpm, yarn)
/pnpm-lock.yaml
/pnpm-store
/pnpmfile.js
/package-lock.json

# Vaadin generated files (may contain Vite cache, etc.)
# This folder caches the front-end modules that the project depends upon.
/frontend/
# NOTE: If you have custom CSS/TS/JS in frontend/src, you MUST NOT ignore the entire /frontend/
# Instead, ignore just the generated files/directories within it:
#/frontend/target/ 
#/frontend/generated-flow-grizzly-server
#/frontend/vaadin-dev-server-settings.json

# Auto-generated index.html (if applicable)
/index.html
# Auto-generated module folder
/Vaadin UI/

# Browser drivers for local integration tests (TestBench)
/drivers/

# ----------------------------------------
# 3. IDE
# ----------------------------------------

### 3.1 INTELLIJ IDEA ###
# IntelliJ project files
.idea/
# Specific files that may exist
*.iml
*.iws
*.ipr
# Temporary files
*.swp


### 3.2 Eclipse ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

### 3.3 NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

### 3.4 VS Code ###
.vscode/


# ----------------------------------------
# 4. OPERATING SYSTEM
# ----------------------------------------
# Mac OS
.DS_Store
# Windows
Thumbs.db
Desktop.ini


# ----------------------------------------
# 5. MAVEN WRAPPER
# ----------------------------------------
# Maven wrapper files are usually committed, but the JAR is often ignored.
# You can commit the wrapper scripts (mvnw, mvnw.cmd) and the .mvn folder
# but ignore the downloaded binary:
/.mvn/wrapper/maven-wrapper.jar